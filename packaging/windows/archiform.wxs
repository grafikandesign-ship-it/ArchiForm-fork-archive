<?xml version="1.0" encoding="UTF-8"?>
<!--
  ArchiForm installer (WiX Toolset v5).

  Per-machine install under Program Files\ArchiForm with ArchiForm.exe,
  ccad.exe, the documents and the sample project; a Start menu shortcut; the
  .ccad extension opens with ArchiForm; an optional feature adds the folder
  to the system PATH so `ccad` runs from any terminal. Newer versions replace
  older ArchiForm releases (the UpgradeCode below must never change).

  Build (see .github/workflows/release.yml):
    wix build packaging/windows/archiform.wxs -arch x64 -ext WixToolset.UI.wixext
      -d Version=1.2.3 -d BinDir=<dir with the .exe files> -d LicenseRtf=<License.rtf>
      -o ArchiForm.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="ArchiForm"
    Manufacturer="ArchiForm"
    Version="$(var.Version)"
    UpgradeCode="C7A4384E-7401-48AD-AC95-10CC58FE2844"
    Scope="perMachine"
    Language="1033"
    Compressed="yes">
    <SummaryInformation Description="ArchiForm - architectural BIM authoring" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ArchiForm.ico" SourceFile="assets\icons\app-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ArchiForm.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/grafikandesign-ship-it/ArchiForm" />
    <Property Id="ARPHELPLINK" Value="https://github.com/grafikandesign-ship-it/ArchiForm/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ArchiForm">
        <Directory Id="ExamplesFolder" Name="examples" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Component Id="App">
        <File Id="ArchiForm.exe" Source="$(var.BinDir)\archiform.exe" Name="ArchiForm.exe" KeyPath="yes">
          <Shortcut
            Id="StartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="ArchiForm"
            Description="Architectural BIM authoring"
            WorkingDirectory="INSTALLFOLDER"
            Icon="ArchiForm.ico"
            Advertise="yes" />
        </File>
        <!-- .ccad projects open with ArchiForm. -->
        <ProgId Id="ArchiForm.Project" Description="ArchiForm project" Icon="ArchiForm.exe" IconIndex="0">
          <Extension Id="ccad" ContentType="application/x-archiform">
            <Verb Id="open" Command="Open" TargetFile="ArchiForm.exe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>
      <Component Id="Cli">
        <File Id="ccad.exe" Source="$(var.BinDir)\ccad.exe" KeyPath="yes" />
      </Component>
      <Component Id="Readme">
        <File Id="README.md" Source="README.md" KeyPath="yes" />
      </Component>
      <Component Id="ReadmePtBr">
        <File Id="README.pt_BR.md" Name="README.pt-BR.md" Source="README.pt-BR.md" KeyPath="yes" />
      </Component>
      <Component Id="Changelog">
        <File Id="CHANGELOG.md" Source="CHANGELOG.md" KeyPath="yes" />
      </Component>
      <Component Id="License">
        <File Id="LICENSE" Name="LICENSE.txt" Source="LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="Sample" Directory="ExamplesFolder">
        <File Id="casa_simples.ccad" Source="examples\casa_simples.ccad" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The install folder at the end of the system PATH, for `ccad`. -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER">
      <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\ArchiForm" Name="CliOnPath" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature
      Id="Main"
      Title="ArchiForm"
      Description="The ArchiForm application, the ccad command line, the documents and the sample project."
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no"
      Display="expand"
      ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProgramFiles" />
      <Feature
        Id="CliPath"
        Title="Add ccad to the PATH"
        Description="Lets you run the ccad command line (and its MCP server) from any terminal."
        Level="1"
        AllowAdvertise="no">
        <ComponentRef Id="PathEntry" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
